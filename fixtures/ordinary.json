{
  "phases": [
    {
      "routes": [
        {
          "path": "/exchange/page-1",
          "headers": {
            "content-type": "application/json"
          },
          "body": "{\"request\": \"page-1\", \"events\": [{\"status\": 103, \"headers\": {\"link\": \"</assets/logo>; rel=preload; as=image\"}}, {\"status\": 200, \"headers\": {\"content-type\": \"text/html\", \"etag\": \"page-a\"}, \"body\": \"<html><body><img src=\\\"/assets/photo-a\\\">开放车间</body></html>\"}]}"
        },
        {
          "path": "/exchange/slow",
          "json": {
            "request": "slow",
            "events": [
              { "status": 103, "headers": { "link": "</assets/photo-slow>; rel=preload; as=image" } },
              { "status": 200, "headers": { "content-type": "text/html", "etag": "page-slow" }, "body": "<html><body><img src=\"/assets/photo-slow\">慢速配图</body></html>" }
            ]
          }
        },
        {
          "path": "/exchange/external",
          "json": {
            "request": "external",
            "events": [
              { "status": 103, "headers": { "link": "</assets/logo>; rel=preload; as=image" } },
              { "status": 302, "headers": { "location": "https://example.invalid/elsewhere" } }
            ]
          }
        },
        {
          "path": "/exchange/broken",
          "json": {
            "request": "broken",
            "events": [
              { "status": 103, "headers": { "link": "</assets/missing>; rel=preload; as=image" } },
              { "status": 200, "headers": { "content-type": "text/html" }, "body": "<html><body><img src=\"/assets/missing\">缺失配图</body></html>" }
            ]
          }
        },
        {
          "path": "/pages/live",
          "headers": {
            "content-type": "text/html"
          },
          "earlyHints": "</assets/logo>; rel=preload; as=image",
          "body": "<html><body><img src=\"/assets/photo-a\">开放车间</body></html>"
        },
        {
          "path": "/pages/final",
          "headers": {
            "content-type": "text/html"
          },
          "body": "<html><body><img src=\"/assets/photo-b\">工厂介绍</body></html>"
        },
        {
          "path": "/assets/logo",
          "headers": {
            "content-type": "image/png"
          },
          "base64": "bG9jYWwtbG9nby1ieXRlcw=="
        },
        {
          "path": "/assets/photo-a",
          "headers": {
            "content-type": "image/png",
            "etag": "asset-a"
          },
          "base64": "bG9jYWwtcGhvdG8tYQ=="
        },
        {
          "path": "/assets/photo-b",
          "headers": {
            "content-type": "image/png"
          },
          "base64": "bG9jYWwtcGhvdG8tYg=="
        },
        {
          "path": "/assets/photo-slow",
          "headers": {
            "content-type": "image/png"
          },
          "delayMs": 300,
          "base64": "bG9jYWwtcGhvdG8tc2xvdw=="
        }
      ]
    }
  ]
}
